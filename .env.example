DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/btc_agent
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
DECISION_REVIEW_MODEL=

# Optional: send a summary after each saved 15m agent decision.
# Message @BotFather-created bot once, then set both values and restart the scheduler.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# M15/H1 PAPER profile. Limits are fractions of equity; leverage stays 1x.
PAPER_MAX_RISK_PER_POSITION=0.02
PAPER_MAX_TOTAL_RISK=0.06
PAPER_MAX_POSITION_MARGIN=0.40
PAPER_MAX_TOTAL_MARGIN=0.80
PAPER_MIN_FREE_MARGIN=0.10
PAPER_MAX_POSITIONS=5
PAPER_MIN_NOTIONAL=10
PAPER_MIN_TP_NET_PROFIT_USD=0.01
PAPER_ALLOW_POSITIONS_WITHOUT_SL=false
PAPER_NO_SL_MAX_MARGIN=0.05
PAPER_NO_SL_MAX_HOURS=4
PAPER_MAX_HOLD_HOURS=24
PAPER_EMERGENCY_DRAWDOWN=0.15
PAPER_MAX_CANDLE_AGE_SECONDS=150
PAPER_MIN_CONSECUTIVE_1M=3
PAPER_MIN_STOP_M15_ATR_MULTIPLE=1.0
PAPER_STOP_SWING_M15_CANDLES=2
PAPER_STOP_SWING_ATR_BUFFER=0.25

# Fee rates are versioned in paper_fee_profiles by seed_paper_account.py.
# --okx-eea-taker-profile sets 0.10% taker on each side, 4 bps fixed spread, and zero other costs.
# --estimated-demo-profile retains older fictional assumptions for comparison.
