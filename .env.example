DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/btc_agent
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
DECISION_REVIEW_MODEL=

# Optional: send only actual PAPER position OPENED/CLOSED events. No analysis or audit reports.
# Message @BotFather-created bot once, then set both values and restart the scheduler.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# M15/H1 PAPER profile. Limits are fractions of equity; leverage stays 1x.
PAPER_MAX_RISK_PER_POSITION=0.03
PAPER_MAX_TOTAL_RISK=0.09
PAPER_MAX_POSITION_MARGIN=0.50
PAPER_MAX_TOTAL_MARGIN=0.90
PAPER_MIN_FREE_MARGIN=0.05
PAPER_MAX_POSITIONS=5
PAPER_MIN_NOTIONAL=10
PAPER_MIN_TP_NET_PROFIT_USD=0.01
PAPER_ALLOW_POSITIONS_WITHOUT_SL=false
PAPER_NO_SL_MAX_MARGIN=0.05
PAPER_NO_SL_MAX_HOURS=4
PAPER_MAX_HOLD_HOURS=24
PAPER_EMERGENCY_DRAWDOWN=0.15
PAPER_MAX_CANDLE_AGE_SECONDS=150
PAPER_MIN_CONSECUTIVE_1M=3
PAPER_MIN_STOP_M15_ATR_MULTIPLE=1.0
PAPER_STOP_SWING_M15_CANDLES=2
PAPER_STOP_SWING_ATR_BUFFER=0.25
# Experimental filters are disabled unless explicitly set and compared in replay.
PAPER_EXPERIMENTAL_MIN_RR_AFTER_COSTS=0
PAPER_EXPERIMENTAL_MAX_CHASE_ATR=0
PAPER_PENDING_MAX_ACTIVE=3
PAPER_PENDING_MAX_TTL_MINUTES=60
PAPER_PENDING_MAX_DISTANCE_USD=2000

# Active PAPER model is CFD20: fixed $20/BTC full spread, zero other fees.
# Activate once after Alembic migration: python -m scripts.seed_paper_account --cfd20
# Old fee snapshots remain for historical positions. Legacy flags cannot reactivate them.
